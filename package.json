{
  "name": "expo-desktop-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "format": "oxfmt",
    "rp": "pnpm --filter custom-changeset run pre",
    "r1": "pnpm --filter custom-changeset run add",
    "r2": "pnpm --filter custom-changeset run version && pnpm install --lockfile-only",
    "r3": "pnpm --filter custom-changeset run publish"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0"
  },
  "lint-staged": {
    "*.{css,html,js,jsx,json,md,toml,ts,tsx}": [
      "oxfmt"
    ],
    "!(pnpm-lock).yaml": [
      "oxfmt"
    ]
  }
}
