{
  "name": "expo-desktop-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "format": "oxfmt",
    "rp": "node scripts/custom-changeset/src/pre.ts",
    "r1": "node scripts/custom-changeset/src/add.ts",
    "r2": "node scripts/custom-changeset/src/version.ts && pnpm install --lockfile-only --offline --ignore-scripts",
    "r3": "node scripts/custom-changeset/src/publish.ts"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0"
  },
  "lint-staged": {
    "*.{css,html,js,jsx,json,md,toml,ts,tsx}": [
      "oxfmt"
    ],
    "!(pnpm-lock).yaml": [
      "oxfmt"
    ]
  }
}
