{
  "name": "expo-desktop-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "format": "oxfmt",
    "rp": "changeset pre",
    "r1": "changeset add",
    "r2": "node scripts/release/src/cli.ts version",
    "r3": "node scripts/release/src/cli.ts publish",
    "release:check": "node scripts/release/src/cli.ts check",
    "release:mode": "node scripts/release/src/cli.ts mode"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0"
  },
  "lint-staged": {
    "*.{css,html,js,jsx,json,md,toml,ts,tsx}": [
      "oxfmt"
    ],
    "!(pnpm-lock).yaml": [
      "oxfmt"
    ]
  }
}
