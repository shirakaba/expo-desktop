{
  "name": "expo-desktop-template-bare-minimum",
  "version": "54.81.1-beta.3",
  "description": "This bare project template includes a minimal setup for using unimodules with React Native.",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shirakaba/expo-desktop.git",
    "directory": "templates/bare-minimum/54.81"
  },
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "macos": "rnc-cli run-macos",
    "windows": "rnc-cli run-windows",
    "autolink-windows": "react-native autolink-windows",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~54.0.35",
    "expo-desktop-modules-core": "~54.0.14-beta.0",
    "expo-desktop-prebuild-config": "~1.1.0-beta.0",
    "expo-desktop-stubs": "~54.0.14-beta.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.7",
    "react-native-windows": "0.81.35"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "0.81.6",
    "@rnx-kit/metro-config": "^2.2.4",
    "@types/react": "~19.2.17",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.4",
    "react-native": "0.81.6"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-native"
      ]
    }
  }
}
