{
  "name": "expo-desktop-template-blank-typescript",
  "version": "54.81.1-beta.6",
  "description": "An Expo Desktop template for React Native v0.81, based on Expo SDK 54",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shirakaba/expo-desktop.git",
    "directory": "templates/blank-typescript/54.81"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "macos": "node -e \"console.log('Please run \\`node --run prebuild\\` to set up the React Native macOS project.'); process.exit(1);\"",
    "windows": "node -e \"console.log('Please run \\`node --run prebuild\\` to set up the React Native Windows project.'); process.exit(1);\"",
    "prebuild": "expo-desktop prebuild",
    "autolink-windows": "react-native autolink-windows",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~54.0.35",
    "expo-desktop": "^1.0.0-beta.8",
    "expo-desktop-modules-core": "~54.0.14-beta.0",
    "expo-desktop-stubs": "~54.0.14-beta.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.9",
    "react-native-windows": "0.81.37"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@types/react": "~19.2.17",
    "expo-desktop-metro-config": "~54.81.0-beta.2",
    "expo-desktop-template-bare-minimum": "~54.81.1-beta.7",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.4",
    "react-native": "0.81.6"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-native"
      ]
    }
  }
}
