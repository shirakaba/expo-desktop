{
  "name": "expo-desktop-template-blank-typescript",
  "version": "55.83.0",
  "description": "An Expo Desktop template for React Native v0.83, based on Expo SDK 55",
  "homepage": "https://github.com/shirakaba/expo-desktop/tree/main/templates/blank-typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shirakaba/expo-desktop.git",
    "directory": "templates/blank-typescript"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "macos": "node -e \"console.log('Please run \\`node --run prebuild\\` to set up the React Native macOS project.'); process.exit(1);\"",
    "windows": "node -e \"console.log('Please run \\`node --run prebuild\\` to set up the React Native Windows project.'); process.exit(1);\"",
    "prebuild": "expo-desktop prebuild",
    "autolink-windows": "react-native autolink-windows",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~55.0.31",
    "expo-desktop": "workspace:^",
    "expo-desktop-modules-core": "workspace:~",
    "expo-desktop-stubs": "workspace:~",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-macos": "0.83.0",
    "react-native-windows": "0.83.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "expo-desktop-metro-config": "workspace:~",
    "expo-desktop-template-bare-minimum": "workspace:~",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.10"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-native"
      ]
    }
  }
}
