{
  "name": "expo-desktop",
  "version": "1.0.0-beta.4",
  "description": "Best-effort desktop support for Expo",
  "keywords": [
    "android",
    "expo",
    "ios",
    "macos",
    "react native",
    "react native desktop",
    "windows"
  ],
  "homepage": "https://github.com/shirakaba/expo-desktop/tree/main/packages/expo-desktop",
  "bugs": {
    "url": "https://github.com/shirakaba/expo-desktop/issues"
  },
  "license": "MIT",
  "author": "Jamie Birch <14055146+shirakaba@users.noreply.github.com> (https://github.com/shirakaba)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shirakaba/expo-desktop.git",
    "directory": "packages/expo-desktop"
  },
  "bin": {
    "expo-desktop": "build/cli.js"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "exports": {
    ".": "./build/cli.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "generate-config": "node scripts/generate-config.ts",
    "schema": "node scripts/update-schema.ts",
    "start": "node src/cli.ts",
    "demo": "npm_config_user_agent=bun node --run start -- create-app --template ../../templates/blank-typescript/54.81/expo-desktop-template-blank-typescript-54.81.0.tgz",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@expo/config": "catalog:expo-latest",
    "@expo/config-plugins": "catalog:expo-latest",
    "@expo/env": "catalog:expo-latest",
    "@expo/json-file": "catalog:expo-latest",
    "@expo/package-manager": "catalog:expo-latest",
    "arktype": "^2.2.0",
    "chalk": "^4.1.2",
    "citty": "^0.2.2",
    "debug": "^4.4.3",
    "expo-desktop-config-plugins": "workspace:^",
    "expo-desktop-prebuild-config": "workspace:^",
    "getenv": "^2.0.0",
    "glob": "^10.5.0",
    "kleur": "^4.1.5",
    "multitars": "^1.0.0",
    "mustache": "^4.2.0",
    "ora": "3.4.0",
    "picomatch": "^2.3.2",
    "prompts": "^2.4.2",
    "resolve-from": "^5.0.0",
    "semver": "^7.6.0",
    "toml": "^4.1.1"
  },
  "devDependencies": {
    "@octokit/types": "^13.5.0",
    "@tsconfig/node24": "catalog:base",
    "@types/getenv": "^1.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "catalog:base",
    "@types/picomatch": "^2.3.3",
    "@types/prompts": "2.0.14",
    "@types/semver": "^7.5.8",
    "@typescript/native-preview": "catalog:base",
    "vitest": "catalog:base"
  },
  "lint-staged": {
    "scripts/update-schema.ts": [
      "node --run schema",
      "oxfmt"
    ],
    "src/app-config.ts": [
      "node --run schema",
      "oxfmt"
    ]
  }
}
